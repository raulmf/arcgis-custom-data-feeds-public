{
  "name": "featureserver",
  "version": "12.1.0",
  "description": "A partial implementation of the GeoServices specification in JavaScript",
  "main": "src/index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "mocha '**/*.spec.js' --reporter even-more-min --recursive -t 5000",
    "cov:unit:json": "nyc -r=json-summary -r=json --report-dir=.coverage/all --temp-dir=.coverage/all/analysis npm test"
  },
  "contributors": [
    {
      "name": "Daniel Fenton"
    },
    {
      "name": "Rich Gwozdz",
      "email": "rgwozdz@esri.com"
    }
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@esri/proj-codes": "^3.6.0",
    "@terraformer/arcgis": "^2.1.2",
    "@turf/bbox-polygon": "^7.3.4",
    "@turf/envelope": "^7.3.4",
    "chroma-js": "^3.2.0",
    "geojson-validation": "^1.0.2",
    "iso-datestring-validator": "^2.2.2",
    "joi": "^18.0.2",
    "lodash": "^4.17.23",
    "postgres-date": "^2.1.0",
    "proj4": "^2.20.3",
    "protobufjs": "^8.0.0",
    "reproject": "^1.2.7",
    "wkt-parser": "^1.5.3"
  },
  "devDependencies": {
    "coverage-badges-cli": "^2.2.0",
    "even-more-min": "^1.0.1",
    "mocha": "^11.7.5",
    "proxyquire": "^2.1.3",
    "should": "^13.2.3",
    "should-sinon": "0.0.6",
    "sinon": "^21.0.1"
  },
  "files": [
    "src/**/*.js",
    "index.d.ts",
    "!**/*.spec.js"
