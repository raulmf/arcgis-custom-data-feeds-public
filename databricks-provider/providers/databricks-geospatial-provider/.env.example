# Copy to .env locally and supply your own workspace settings.
# Never include .env or real credentials in deployment packages.
DATABRICKS_SERVER_HOSTNAME=workspace.example.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/0000000000000000
DATABRICKS_ACCESS_TOKEN=
DATABRICKS_DEFAULT_TABLE=catalog.schema.features
DATABRICKS_GEOMETRY_COLUMN=geometry
DATABRICKS_ID_FIELD=id
DATABRICKS_GEOMETRY_FORMAT=WKT
ENABLE_AUDIT_LOG=false
